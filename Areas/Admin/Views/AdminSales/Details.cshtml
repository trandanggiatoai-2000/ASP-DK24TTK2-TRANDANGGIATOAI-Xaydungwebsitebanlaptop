@model AdminOrderViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết đơn hàng";
    var canUpdateOrders = (bool)(ViewBag.CanUpdateOrders ?? false);
    var canCancelOrders = (bool)(ViewBag.CanCancelOrders ?? false);
}
<div class="section-head">
    <h1>Chi tiết đơn hàng</h1>
    <span>@Model.OrderCode</span>
</div>
<div class="order-detail-grid">
    <div class="card-surface">
        <h2>Thông tin khách hàng</h2>
        <div class="order-meta-list">
            <div><strong>Khách hàng:</strong> @Model.CustomerName</div>
            <div><strong>Số điện thoại:</strong> @Model.Phone</div>
            <div><strong>Địa chỉ:</strong> @Model.AddressLine</div>
            <div><strong>Ghi chú:</strong> @Model.Note</div>
            <div><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Thanh toán:</strong> @Model.PaymentMethod</div>
            <div><strong>Trạng thái:</strong> @Model.OrderStatus</div>
        </div>
    </div>
    <div class="card-surface">
        <h2>Thao tác</h2>
        <div class="order-action-stack">
            <a asp-action="Details" asp-route-id="@Model.OrderId" asp-route-print="invoice" target="_blank" class="btn-secondary admin-mini-btn">In hóa đơn</a>
            <a asp-action="Details" asp-route-id="@Model.OrderId" asp-route-print="delivery" target="_blank" class="btn-secondary admin-mini-btn">In phiếu giao hàng</a>
            @if (canUpdateOrders && Model.CanMarkDelivered)
            {
                <form asp-action="MarkDelivered" method="post">
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    <button type="submit" class="btn-primary admin-mini-btn">Chuyển giao hàng</button>
                </form>
            }
            @if (canCancelOrders && Model.CanCancel)
            {
                <form asp-action="Cancel" method="post" onsubmit="return confirm('Xác nhận hủy đơn hàng này?');">
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    <button type="submit" class="btn-danger admin-mini-btn">Hủy đơn</button>
                </form>
            }
            @if (!canUpdateOrders && !canCancelOrders)
            {
                <span class="review-date">Tài khoản này chỉ có quyền xem đơn.</span>
            }
        </div>
    </div>
</div>

<div class="card-surface">
    <h2>Sản phẩm trong đơn</h2>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@item.LineTotal.ToString("N0") đ</td>
            </tr>
        }
        </tbody>
    </table>
    <div class="order-total-line">Tổng cộng: <strong>@Model.TotalAmount.ToString("N0") đ</strong></div>
</div>

