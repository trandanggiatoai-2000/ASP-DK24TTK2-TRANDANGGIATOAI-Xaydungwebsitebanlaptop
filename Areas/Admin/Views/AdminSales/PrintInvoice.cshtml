@using websitebanlaptop.Services.Contracts
@inject ILayoutContentService LayoutContentService
@{
    var site = await LayoutContentService.GetWebsiteSettingsAsync();
}
@model AdminOrderViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>HÓA ĐƠN BÁN HÀNG</title>
    <style>
        body{font-family:Arial,Helvetica,sans-serif;color:#111;padding:24px;font-size:18px;margin:0}
        .print-wrap{max-width:980px;margin:0 auto}
        .shop-head{text-align:center;margin-bottom:22px}
        .shop-logo{font-size:30px;font-weight:800;letter-spacing:.5px;display:flex;justify-content:center;align-items:center;gap:14px;flex-direction:column}
        .shop-logo img{max-height:84px;max-width:280px;object-fit:contain;display:block}
        .shop-name{font-size:30px;font-weight:800;letter-spacing:.5px;line-height:1.15}
        .shop-sub{margin-top:6px;color:#444;font-size:16px}
        h1{margin:0 0 10px;font-size:34px}
        .sub{margin-bottom:18px;font-size:18px}
        .actions{margin:0 0 20px}
        button{padding:10px 18px;border:1px solid #999;background:#fff;border-radius:4px;cursor:pointer}
        .meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0 22px}
        .box{border:1px solid #d9d9d9;border-radius:12px;padding:16px}
        .box div{margin:4px 0}
        table{width:100%;border-collapse:collapse;margin-top:10px}
        th,td{border:1px solid #d9d9d9;padding:12px;text-align:left;vertical-align:top}
        th{background:#fafafa}
        .total{margin-top:14px;text-align:right;font-size:20px;font-weight:700}
        .sign-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:48px}
        .sign-box{text-align:center}
        .sign-title{font-weight:700;font-size:20px}
        .sign-note{margin-top:8px;color:#444;font-size:15px}
        .sign-space{height:120px}
        @@media print{
            .actions{display:none}
            body{padding:0}
            .print-wrap{max-width:none}
        }
    </style>
</head>
<body>
<div class="print-wrap">
    <div class="actions"><button onclick="window.print()">In ngay</button></div>

    <div class="shop-head">
        <div class="shop-logo">
            @if (!string.IsNullOrWhiteSpace(site.WebsiteLogoUrl))
            {
                <img src="@site.WebsiteLogoUrl" alt="@site.StoreName" />
            }
            <div class="shop-name">@(string.IsNullOrWhiteSpace(site.StoreName) ? site.LogoText : site.StoreName)</div>
        </div>
        <div class="shop-sub">@site.StoreTagline</div>
    </div>

    <h1>HÓA ĐƠN BÁN HÀNG</h1>
    <div class="sub">Mã đơn: <strong>@Model.OrderCode</strong></div>

    <div class="meta">
        <div class="box">
            <div><strong>Khách hàng:</strong> @Model.CustomerName</div>
            <div><strong>Điện thoại:</strong> @Model.Phone</div>
            <div><strong>Địa chỉ:</strong> @Model.AddressLine</div>
            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div><strong>Ghi chú:</strong> @Model.Note</div>
            }
        </div>
        <div class="box">
            <div><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Thanh toán:</strong> @Model.PaymentMethod</div>
            <div><strong>Trạng thái:</strong> @Model.OrderStatus</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>SL</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@item.LineTotal.ToString("N0") đ</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="total">Tổng cộng: @Model.TotalAmount.ToString("N0") đ</div>

    <div class="sign-grid">
        <div class="sign-box">
            <div class="sign-title">BÊN GIAO</div>
            <div class="sign-note">(Ký và ghi rõ họ tên)</div>
            <div class="sign-space"></div>
        </div>
        <div class="sign-box">
            <div class="sign-title">BÊN NHẬN</div>
            <div class="sign-note">(Ký và ghi rõ họ tên)</div>
            <div class="sign-space"></div>
        </div>
    </div>
</div>
</body>
</html>

