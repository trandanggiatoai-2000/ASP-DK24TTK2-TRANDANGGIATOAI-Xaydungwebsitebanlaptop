@model CartPageViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}
<div class="cart-layout">
    <section class="card-surface">
        <h1>Giỏ hàng của bạn</h1>
        @if (!Model.Items.Any())
        {
            <p>Chưa có sản phẩm nào trong giỏ hàng.</p>
        }
        else
        {
            <table class="cart-table">
                <thead>
                    <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="cart-product-cell">
                                <img src="@item.ImageUrl" alt="@item.ProductName" data-fallback="/images/products/placeholder-generic.svg" />
                                <div>
                                    <strong>@item.ProductName</strong>
                                    <div>@item.Brand</div>
                                </div>
                            </div>
                        </td>
                        <td>@item.UnitPrice.ToString("N0") đ</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Update" method="post" class="qty-form">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" />
                                <button type="submit">Cập nhật</button>
                            </form>
                        </td>
                        <td>@item.LineTotal.ToString("N0") đ</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button class="link-btn" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
    <aside class="card-surface cart-summary">
        <h3>Tóm tắt đơn hàng</h3>
        <div class="summary-row"><span>Tạm tính</span><strong>@Model.Subtotal.ToString("N0") đ</strong></div>
        <div class="summary-row"><span>Phí giao hàng</span><strong>@Model.ShippingFee.ToString("N0") đ</strong></div>
        <div class="summary-row total"><span>Tổng cộng</span><strong>@Model.Total.ToString("N0") đ</strong></div>
        <a class="btn-primary wide" asp-controller="Checkout" asp-action="Index">Chuyển qua thanh toán</a>
        <p style="margin-top:12px;color:#64748b;font-size:14px">Ở bước tiếp theo bạn sẽ chọn hình thức thanh toán: thanh toán sau hoặc chuyển khoản ngân hàng.</p>
    </aside>
</div>

