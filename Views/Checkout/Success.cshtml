@{
    ViewData["Title"] = "Kết quả thanh toán";
}
<div class="row justify-content-center my-4 my-lg-5">
    <div class="col-xl-8 col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 text-center">
            <div class="card-body p-4 p-lg-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success fs-1 fw-bold mb-4" style="width:72px;height:72px;">&#10003;</div>
                <h1 class="h2 fw-bold mb-3">@ViewBag.SuccessTitle</h1>
                <p class="lead text-body-secondary mb-4">@ViewBag.SuccessMessage</p>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="bg-body-tertiary border rounded-4 h-100 p-3">
                            <span class="d-block text-body-secondary small mb-2">Mã đơn hàng</span>
                            <strong>@ViewBag.OrderCode</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-body-tertiary border rounded-4 h-100 p-3">
                            <span class="d-block text-body-secondary small mb-2">Hình thức thanh toán</span>
                            <strong>@ViewBag.PaymentMethod</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-body-tertiary border rounded-4 h-100 p-3">
                            <span class="d-block text-body-secondary small mb-2">Trạng thái thanh toán</span>
                            <strong>@ViewBag.PaymentStatusText</strong>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-4 mb-4" role="alert">
                    @ViewBag.SuccessMessage
                </div>

                <div class="d-flex justify-content-center">
                    <a class="btn btn-dark btn-lg rounded-pill px-4" asp-controller="Home" asp-action="Index">Quay về trang chủ để tiếp tục mua sắm</a>
                </div>
            </div>
        </div>
    </div>
</div>
