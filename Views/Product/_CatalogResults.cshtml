@model CatalogPageViewModel
@{
    var settings = Model.WebsiteSettings;
    var normalizedCategory = (Model.Category ?? string.Empty).Trim().ToLowerInvariant();
    var isAccessories = normalizedCategory == "phụ kiện";
    var isComponents = normalizedCategory == "linh kiện";
    var isDesktop = normalizedCategory == "máy tính bộ" || normalizedCategory == "máy tính bàn";
    var isWorkstationAlias = normalizedCategory.Contains("gaming");
    var isGaming = normalizedCategory.Contains("gaming");
    var isOffice = normalizedCategory.Contains("văn phòng") || normalizedCategory.Contains("office");
    var isPremium = normalizedCategory.Contains("cao cấp") || normalizedCategory.Contains("premium");
    var isGraphics = normalizedCategory.Contains("đồ họa") || normalizedCategory.Contains("graphics");
    var isAccessoryPage = isAccessories || isComponents;
    var pageTitle = isAccessories ? "Phụ kiện" : isComponents ? "Linh kiện" : isDesktop ? "Máy tính bộ" : "Laptop Máy Trạm";
    var pageDesc = isAccessories ? $"Tìm được {Model.TotalItems} phụ kiện phù hợp cho bàn phím, chuột, tai nghe, hub và đế tản nhiệt."
        : isComponents ? $"Tìm được {Model.TotalItems} linh kiện phù hợp cho RAM, SSD, pin, sạc và các linh kiện nâng cấp."
        : isDesktop ? $"Tìm được {Model.TotalItems} bộ máy phù hợp cho văn phòng, mini PC, workstation và doanh nghiệp."
        : $"Tìm được {Model.TotalItems} sản phẩm phù hợp. Có thể lọc thêm theo CPU, RAM và SSD.";
    var accessoryTabs = isAccessories
        ? new[] { "Bàn phím", "Chuột", "Tai nghe", "USB Wifi", "Hub chuyển đổi", "Đế quạt tản nhiệt" }
        : new[] { "RAM", "SSD", "Ổ cứng", "Sạc", "Pin", "Mainboard" };

    var categoryBanner = string.Empty;
    if (isAccessories)
    {
        categoryBanner = settings.CategoryBannerAccessoryUrl ?? string.Empty;
    }
    else if (isComponents)
    {
        categoryBanner = settings.CategoryBannerComponentUrl ?? string.Empty;
    }
    else if (isDesktop)
    {
        categoryBanner = settings.CategoryBannerGraphicsUrl ?? string.Empty;
    }
    else if (isGaming)
    {
        categoryBanner = settings.CategoryBannerGamingUrl ?? string.Empty;
    }
    else if (isOffice)
    {
        categoryBanner = settings.CategoryBannerOfficeUrl ?? string.Empty;
    }
    else if (isPremium)
    {
        categoryBanner = settings.CategoryBannerPremiumUrl ?? string.Empty;
    }
    else if (isGraphics)
    {
        categoryBanner = settings.CategoryBannerGraphicsUrl ?? string.Empty;
    }
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body p-4 d-flex flex-column flex-xl-row align-items-xl-end justify-content-between gap-3">
        <div>
            <div class="eyebrow">DANH SÁCH SẢN PHẨM</div>
            <h1 class="h3 fw-bold mb-2">@pageTitle</h1>
            <p class="text-secondary mb-0" style="max-width: 40rem;">@pageDesc</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Product" asp-action="Catalog" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@(!Model.Official)" asp-route-fast="@Model.FastDelivery" asp-route-installment="@Model.Installment" class="btn @(Model.Official ? "btn-primary" : "btn-outline-secondary") rounded-pill" data-ajax-catalog-link data-ajax-toggle="official">Hàng chính hãng</a>
            <a asp-controller="Product" asp-action="Catalog" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@Model.Official" asp-route-fast="@(!Model.FastDelivery)" asp-route-installment="@Model.Installment" class="btn @(Model.FastDelivery ? "btn-primary" : "btn-outline-secondary") rounded-pill" data-ajax-catalog-link data-ajax-toggle="fast">Giao nhanh</a>
            <a asp-controller="Product" asp-action="Catalog" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@Model.Official" asp-route-fast="@Model.FastDelivery" asp-route-installment="@(!Model.Installment)" class="btn @(Model.Installment ? "btn-primary" : "btn-outline-secondary") rounded-pill" data-ajax-catalog-link data-ajax-toggle="installment">Trả góp 0%</a>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(categoryBanner))
{
    <div class="catalog-category-banner card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
        <img src="@categoryBanner" alt="@pageTitle" />
    </div>
}

@if (isAccessoryPage)
{
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body p-3 d-flex flex-column gap-3">
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tab in accessoryTabs)
                {
                    var isActiveTab = string.Equals(Model.Keyword, tab, StringComparison.OrdinalIgnoreCase);
                    <a asp-controller="Product" asp-action="Catalog" asp-route-category="@Model.Category" asp-route-keyword="@tab" class="btn @(isActiveTab ? "btn-dark" : "btn-outline-secondary") btn-sm rounded-pill" data-ajax-catalog-link>@tab</a>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Product" asp-action="Catalog" asp-route-category="@Model.Category" asp-route-keyword="@Model.Keyword" class="btn btn-outline-primary btn-sm rounded-pill" data-ajax-catalog-link>Giá thấp đến cao</a>
                <a asp-controller="Product" asp-action="Catalog" asp-route-category="@Model.Category" asp-route-keyword="@Model.Keyword" class="btn btn-outline-primary btn-sm rounded-pill" data-ajax-catalog-link>Giá cao đến thấp</a>
            </div>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    @if (!string.IsNullOrWhiteSpace(Model.Brand))
    {
        <span class="badge rounded-pill text-bg-light border px-3 py-2">Hãng: @Model.Brand</span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Category))
    {
        <span class="badge rounded-pill text-bg-light border px-3 py-2">Nhu cầu: @Model.Category</span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Cpu))
    {
        <span class="badge rounded-pill text-bg-light border px-3 py-2">CPU: @Model.Cpu</span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Ram))
    {
        <span class="badge rounded-pill text-bg-light border px-3 py-2">RAM: @Model.Ram</span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Ssd))
    {
        <span class="badge rounded-pill text-bg-light border px-3 py-2">SSD: @Model.Ssd</span>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
    {
        <span class="badge rounded-pill text-bg-light border px-3 py-2">Từ khóa: @Model.Keyword</span>
    }
    @if (Model.Official)
    {
        <span class="badge rounded-pill text-primary bg-primary-subtle border px-3 py-2">Hàng chính hãng</span>
    }
    @if (Model.FastDelivery)
    {
        <span class="badge rounded-pill text-primary bg-primary-subtle border px-3 py-2">Giao nhanh</span>
    }
    @if (Model.Installment)
    {
        <span class="badge rounded-pill text-primary bg-primary-subtle border px-3 py-2">Trả góp 0%</span>
    }
</div>

<div class="row row-cols-1 row-cols-lg-3 g-3 mb-3">
    <div class="col">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body small text-secondary">
                <strong class="d-block text-dark mb-1">Hàng chính hãng</strong>
                Sản phẩm đầy đủ VAT, bảo hành 12 tháng tại hãng hoặc trung tâm ủy quyền.
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body small text-secondary">
                <strong class="d-block text-dark mb-1">Giao nhanh</strong>
                Ưu tiên giao 2H nội thành hoặc giao liên tỉnh nhanh với sản phẩm còn sẵn kho.
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body small text-secondary">
                <strong class="d-block text-dark mb-1">Trả góp 0%</strong>
                Áp dụng cho nhiều mẫu từ 15 triệu, hỗ trợ thẻ tín dụng và đối tác tài chính.
            </div>
        </div>
    </div>
</div>

<div class="product-grid ecommerce-grid">
    @foreach (var product in Model.Products)
    {
        @await Html.PartialAsync("_ProductCard", product)
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex flex-column align-items-center gap-3 my-4">
        <div class="text-secondary fw-semibold text-center">Hiển thị @Model.StartItem-@Model.EndItem trên tổng @Model.TotalItems sản phẩm.</div>
        <nav aria-label="Phân trang sản phẩm">
            <ul class="pagination pagination-lg flex-wrap justify-content-center mb-0">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link rounded-pill mx-1" asp-controller="Product" asp-action="Catalog" asp-route-page="@(Model.Page - 1)" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@Model.Official" asp-route-fast="@Model.FastDelivery" asp-route-installment="@Model.Installment" data-ajax-catalog-link aria-label="Trang trước">←</a>
                    </li>
                }
                @{
                    var startPage = Math.Max(1, Model.Page - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                }
                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : string.Empty)">
                        <a class="page-link rounded-pill mx-1" asp-controller="Product" asp-action="Catalog" asp-route-page="@i" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@Model.Official" asp-route-fast="@Model.FastDelivery" asp-route-installment="@Model.Installment" data-ajax-catalog-link>@i</a>
                    </li>
                }
                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link rounded-pill mx-1" asp-controller="Product" asp-action="Catalog" asp-route-page="@(Model.Page + 1)" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@Model.Official" asp-route-fast="@Model.FastDelivery" asp-route-installment="@Model.Installment" data-ajax-catalog-link aria-label="Trang sau">→</a>
                    </li>
                }
            </ul>
        </nav>
        @if (Model.HasNextPage)
        {
            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Product" asp-action="Catalog" asp-route-page="@(Model.Page + 1)" asp-route-keyword="@Model.Keyword" asp-route-brand="@Model.Brand" asp-route-category="@Model.Category" asp-route-cpu="@Model.Cpu" asp-route-ram="@Model.Ram" asp-route-ssd="@Model.Ssd" asp-route-official="@Model.Official" asp-route-fast="@Model.FastDelivery" asp-route-installment="@Model.Installment" data-ajax-catalog-link>Xem thêm @Math.Min(Model.PageSize, Model.RemainingItems) sản phẩm</a>
        }
    </div>
}
